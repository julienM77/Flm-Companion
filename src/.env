VITE_MINIMUM_FLM_VERSION=0.9.37

# Debug mode pour tester les modales de startup
# Simuler différentes versions installées (laisser vide pour le comportement normal)
# Exemples :
# - VITE_DEBUG_FLM_VERSION=0.8.0          → FLM version ancienne (< min required)
# - VITE_DEBUG_FLM_VERSION=Unknown        → FLM non installé
# - VITE_DEBUG_FLM_VERSION=0.9.20         → FLM version OK mais mise à jour disponible
# - VITE_DEBUG_COMPANION_VERSION=0.1.0    → Companion version ancienne
#VITE_DEBUG_FLM_VERSION=0.9.20
#VITE_DEBUG_COMPANION_VERSION=0.2.0